      "id": "93e4f171-ab04-4bff-bb34-3928411133f2",
      "name": "Format - Flatten Product Fields"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\n\n// AZÚCAR\nif (data.sugars_100g === undefined || data.sugars_100g === null || data.sugars_100g === '') {\n  data.sugar_level = null; \n} else if (data.sugars_100g < 5) {\n  data.sugar_level = 'bajo';\n} else if (data.sugars_100g <= 22.5) {\n  data.sugar_level = 'medio';\n} else {\n  data.sugar_level = 'alto';\n}\n\n// SAL\nif (data.salt_100g === undefined || data.salt_100g === null || data.salt_100g === '') {\n  data.salt_level = null; \n} else if (data.salt_100g > 1.5) {\n  data.salt_level = 'alto';\n} else {\n  data.salt_level = 'bajo';\n}\n\n// GRASA\nif (data.fat_100g === undefined || data.fat_100g === null || data.fat_100g === '') {\n  data.fat_level = null;\n} else if (data.fat_100g > 17.5) {\n  data.fat_level = 'alto';\n} else {\n  data.fat_level = 'bajo';\n}\n\nreturn data;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        -112
      ],
      "id": "7fa9e6bc-3964-4778-84bb-d1ebdf336d18",
      "name": "Calculate - Traffic Lights Level",
      "notesInFlow": true,
      "notes": "Decide si los nutrientes son bajos, medios o altos"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\n\n// SEMÁFORO\nlet altos = 0;\nif (data.sugar_level === 'alto') altos = altos + 1;\nif (data.salt_level === 'alto') altos = altos + 1;\nif (data.fat_level === 'alto') altos = altos + 1;\n\ndata.concern_score = altos;\n\nif (altos === 0) {\n  data.traffic_light_reading = 'saludable';\n} else if (altos === 1) {\n  data.traffic_light_reading = 'moderado';\n} else {\n  data.traffic_light_reading = 'no saludable';\n}\n\n// NUTRI-SCORE\nconst grade = data.nutriscore_grade;\n\nif (grade === 'a' || grade === 'b') {\n  data.nutriscore_reading = 'saludable';\n} else if (grade === 'c') {\n  data.nutriscore_reading = 'moderado';\n} else if (grade === 'd' || grade === 'e') {\n  data.nutriscore_reading = 'no saludable';\n} else {\n  data.nutriscore_reading = null; \n}\n\nreturn data;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -112
      ],
      "id": "4cea2b51-cca5-4ec1-a9c2-b650886d01ce",
      "name": "Calculate - Concern Levels & Verdict Readings",
      "notesInFlow": true,
      "notes": "Mira qué nota tiene el producto mandado"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\n\nlet semaforo_rango;\nif (data.traffic_light_reading === 'saludable') {\n  semaforo_rango = 0;\n} else if (data.traffic_light_reading === 'moderado') {\n  semaforo_rango = 1;\n} else {\n  semaforo_rango = 2;\n}\n\nif (data.nutriscore_reading === null) {\n  data.verdict_level = data.traffic_light_reading;\n} else {\n  let nutriscore_rango;\n  if (data.nutriscore_reading === 'saludable') {\n    nutriscore_rango = 0;\n  } else if (data.nutriscore_reading === 'moderado') {\n    nutriscore_rango = 1;\n  } else {\n    nutriscore_rango = 2;\n  }\n\n  let peor_rango;\n  if (semaforo_rango > nutriscore_rango) {\n    peor_rango = semaforo_rango;\n  } else {\n    peor_rango = nutriscore_rango;\n  }\n\n  if (peor_rango === 0) {\n    data.verdict_level = 'saludable';\n  } else if (peor_rango === 1) {\n    data.verdict_level = 'moderado';\n  } else {\n    data.verdict_level = 'no saludable';\n  }\n}\n\nif (data.verdict_level === 'no saludable') {\n  data.tone_instruction = 'Cauteloso y honesto, con delicadeza.';\n} else {\n  data.tone_instruction = 'Alentador y positivo.';\n}\n\nreturn data;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1936,
        -112
      ],
      "id": "b77b411f-5836-45cd-bda1-03eef2934a9b",
      "name": "Calculate - Final Verdict & Tone",
      "notesInFlow": true,
      "notes": "Mira el peor resultado y decide el tono a seguir"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Producto: {{ $json.product_name }} ({{ $json.brands }})\nVeredicto: {{ $json.verdict_level }}\nNutri-Score: {{ $json.nutriscore_grade }}\nAzúcar: {{ $json.sugar_level }} ({{ $json.sugars_100g }} g/100g)\nSal: {{ $json.salt_level }} ({{ $json.salt_100g }} g/100g)\nGrasa: {{ $json.fat_level }} ({{ $json.fat_100g }} g/100g)\n\nEscribe el párrafo de veredicto para este producto.",
        "messages": {
          "messageValues": [
            {
              "message": "Eres un amigo que sabe de nutrición y acompaña a alguien en el supermercado. Escribes un solo párrafo corto (2-3 frases), en español, con un tono humano y cercano — nada de listas ni encabezados.  Si el veredicto es \"saludable\" o \"moderado\": tono alentador y positivo. Si el veredicto es \"no saludable\": tono honesto, pero con delicadeza — nunca alarmante ni que suene a regañina.  Puedes mencionar de forma natural por qué llegó a esa conclusión (por ejemplo, mucha azúcar o mucha sal), pero sin sonar a lista de datos. Responde solo con el párrafo, sin nada más alrededor."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        2128,
        -112
      ],
      "id": "1bf64d9c-87b0-4c48-ab3d-6c0fff7d9f7c",
      "name": "AI - Health Verdict (Cautionary)",
      "notesInFlow": true,
      "notes": "La IA escribe el mensaje según el tono sacado del nodo anterior"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json; // trae { text: \"...\" } del nodo de IA\nconst previo = $('Calculate - Final Verdict & Tone').item.json; // aquí SÍ están los demás campos\n\n// EMOJI SEGÚN EL VEREDICTO\nlet emoji;\nif (previo.verdict_level === 'saludable') emoji = '✅';\nelse if (previo.verdict_level === 'moderado') emoji = '🟡';\nelse emoji = '🔴';\n\nconst titular = emoji + ' ' + previo.product_name + ' — ' + previo.verdict_level;\n\n// AZÚCAR\nlet m_azucar;\nif (previo.sugar_level === 'alto') m_azucar = '🔴';\nelse if (previo.sugar_level === 'medio') m_azucar = '🟡';\nelse if (previo.sugar_level === 'bajo') m_azucar = '🟢';\nelse m_azucar = '⚪';\n\n// SAL\nlet m_sal;\nif (previo.salt_level === 'alto') m_sal = '🔴';\nelse if (previo.salt_level === 'bajo') m_sal = '🟢';\nelse m_sal = '⚪';\n\n// GRASA\nlet m_grasa;\nif (previo.fat_level === 'alto') m_grasa = '🔴';\nelse if (previo.fat_level === 'bajo') m_grasa = '🟢';\nelse m_grasa = '⚪';\n\nconst numeros = m_azucar + ' Azúcar: ' + previo.sugars_100g + ' g\\n' +\n                m_sal + ' Sal: ' + previo.salt_100g + ' g\\n' +\n                m_grasa + ' Grasa: ' + previo.fat_100g + ' g';\n\ndata.mensaje_final = titular + '\\n\\n' + numeros + '\\n\\n' + data.text;\n\nreturn data;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2496,
        -112
      ],
      "id": "23753871-d1f8-44aa-95e3-605c0cd7426d",
